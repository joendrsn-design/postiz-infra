# Template for .env — copy to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit real values.

# Signs Postiz session tokens. Generate with: openssl rand -hex 32
# Rotating invalidates all logged-in sessions.
JWT_SECRET=

# Password for the postiz-postgres 'postiz-user' role.
# docker-compose.yaml builds DATABASE_URL from this, so set it in one place only.
# On an existing deployment this must match the password already set in the
# database — changing it here alone will lock Postiz out. See README "Secrets".
POSTIZ_POSTGRES_PASSWORD=
