# Template for .env — copy to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit real values.

# Signs Postiz session tokens. Generate with: openssl rand -hex 32
# Rotating invalidates all logged-in sessions.
JWT_SECRET=

# Password for the postiz-postgres 'postiz-user' role.
# docker-compose.yaml builds DATABASE_URL from this, so set it in one place only.
# On an existing deployment this must match the password already set in the
# database — changing it here alone will lock Postiz out. See README "Secrets".
POSTIZ_POSTGRES_PASSWORD=

# --- Social provider credentials ---
# Empty is fine; a provider just stays unavailable until its keys are set.

# LinkedIn app (developer.linkedin.com) → Auth tab.
# Redirect URLs must include BOTH:
#   https://postiz.dailylatin.org/integrations/social/linkedin
#   https://postiz.dailylatin.org/integrations/social/linkedin-page
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X app (developer.x.com) → Keys and tokens → "Consumer Keys".
# OAuth 1.0a, so these are the API Key / API Secret pair — NOT the Bearer
# token and NOT the Access Token/Secret. App permissions must be Read and
# Write, with callback https://postiz.dailylatin.org/integrations/social/x
X_API_KEY=
X_API_SECRET=
