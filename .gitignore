# Upstream reference clone (gitroomhq/postiz-docker-compose) — has its own .git,
# not part of this deployment's config. See README.
postiz-docker-compose/

# Secrets, once extracted out of docker-compose.yaml.
# .env.* catches timestamped backups (.env.bak-*) and any future .env.local;
# .env.example is the committed template and must stay tracked.
.env
.env.*
!.env.example

# Backup temp artifacts
*.sql.gz
*.tar.gz
